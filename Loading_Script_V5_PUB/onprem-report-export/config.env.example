# =============================================================================
# On-prem scanner report export - configuration template
# Copy to config.env, fill in values, then: chmod 600 config.env
# Do not commit config.env or generated config files.
# =============================================================================

# ---------- Phoenix destination ---------------------------------------------
# Create API credentials in the Phoenix UI.
# Use https://api.poc1.appsecphx.io for PoC.
# Use https://api.securityphoenix.cloud for production.
PHOENIX_API_BASE_URL="https://<phoenix-api-base-url>"
PHOENIX_CLIENT_ID="<phoenix-client-id>"
PHOENIX_CLIENT_SECRET="<phoenix-client-secret>"

# ---------- JFrog X-Ray source ----------------------------------------------
# JFROG_URL is the JFrog Platform base URL, without the /xray suffix.
# Leave JFROG_URL empty to skip X-Ray entirely.
JFROG_URL="https://<jfrog-platform-url>"
JFROG_TOKEN="<jfrog-access-token>"

# Scope for the export. At least one of XRAY_REPOSITORIES or XRAY_PROJECT_KEY is
# REQUIRED when X-Ray is enabled: an unscoped report covers the whole platform.
XRAY_REPOSITORIES="<repository-name>"
XRAY_PROJECT_KEY=""
XRAY_SEVERITIES="High,Critical"

# Optional stable Phoenix asset name for the X-Ray import.
# Defaults to XRAY_PROJECT_KEY, then XRAY_REPOSITORIES, then "jfrog-xray".
XRAY_ASSET_NAME=""

# ---------- Sonatype Nexus IQ source ----------------------------------------
# Leave SONATYPE_APP_PUBLIC_IDS empty to skip Nexus IQ entirely. Comma-separated;
# each application is exported and loaded separately, and becomes one Phoenix
# asset named after its application public id.
SONATYPE_URL="https://<sonatype-nexus-iq-url>"
SONATYPE_USER="<sonatype-user-or-token-id>"
SONATYPE_TOKEN="<sonatype-token-or-password>"
SONATYPE_APP_PUBLIC_IDS="<application-public-id>"
SONATYPE_STAGE="release"

# ---------- Phoenix assessment / import behavior ----------------------------
PHOENIX_ASSESSMENT="On-Prem Scanner Import"
PHOENIX_IMPORT_TYPE="merge"

# ---------- Phoenix Loading Script V5 ---------------------------------------
# This folder is expected to live under Loading_Script_V5_PUB/onprem-report-export,
# so the loader is normally found automatically. Set V5_SCRIPT only to override.
V5_SCRIPT=""
PYTHON_BIN="python3"

XRAY_V5_SCANNER="jfrog_xray_unified"
SONATYPE_V5_SCANNER="sonatype"

OUT_DIR="./reports"
