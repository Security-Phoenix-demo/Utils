[phoenix]
client_id =
client_secret =
api_base_url = https://api.securityphoenix.cloud
import_type = merge
assessment_name = single-repo-sca-sbom

# Which Phoenix API to send to.
#   vulnerability  POST /v1/import/assets - this script parses vulnerabilities out of the
#                  SBOM and posts findings. The SBOM must already contain them.
#   sbom           POST /v1/import/assets/file/translate - uploads the plain SBOM and lets
#                  Phoenix run dep-scan over it to derive vulnerabilities.
method = vulnerability

# sbom method only: sent as scanType "PhxSbomSca:<project_type>".
# universal, js, python, java, go, ...
project_type = universal

[options]
verify_tls = true

# Allow an http:// api_base_url. Off by default: the token call sends client_id and
# client_secret as HTTP Basic, which plaintext HTTP exposes on the wire. Turn it on only for a
# local mock or lab endpoint.
allow_insecure_http = false
timeout_seconds = 60

# sbom method only: poll until Phoenix finishes translating and importing.
# Phoenix runs dep-scan server-side. Successful imports measured 4-5 minutes against a live
# tenant regardless of SBOM size; the multi-hour cases were requests that had collided with a
# concurrent upload and ended in ERROR near the 60-minute mark (see README). 1800s is therefore
# generous for a healthy import and stops a doomed one holding an executor for the full hour.
# The timeout only bounds the waiting - a request that outlives it keeps translating.
wait_for_completion = false
poll_interval_seconds = 10
poll_timeout_seconds = 1800
